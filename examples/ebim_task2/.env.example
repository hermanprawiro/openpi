# Policy server connection for the eval client. Copy to .env (gitignored):
#   cp examples/ebim_task2/.env.example examples/ebim_task2/.env
# Loaded by both docker compose (compose.eval_client.yml) and the client
# itself (eval_client/config.py); real environment variables take
# precedence. These values are never written into eval-result artifacts.
POLICY_SERVER_HOST=localhost
POLICY_SERVER_PORT=8000
# POLICY_SERVER_API_KEY=

# Benchmark repo root (the directory containing task2_isaacsim/), used by
# run_eval.sh to launch the eval_recorder alongside the client. Machine-specific.
# EBIM_ROOT=/home/user/codes/ebim/benchmark
