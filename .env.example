# Hugging Face token used to download the raw dataset (https://huggingface.co/settings/tokens).
HF_TOKEN=hf_your_token_here

# Hugging Face cache root; raw dataset snapshots are downloaded to $HF_HOME/hub.
HF_HOME=~/.cache/huggingface

# Where converted LeRobot datasets are stored.
# Must be the same value for convert_task2_data_to_lerobot.py, compute_norm_stats.py and train.py.
HF_LEROBOT_HOME=~/.cache/huggingface/lerobot
